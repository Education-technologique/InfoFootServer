# Copie ces variables dans l'onglet "Environment" de ton service Render
# (ne jamais committer un vrai fichier .env avec les clés remplies)

# Clé gratuite sur https://dashboard.api-football.com (100 requêtes/jour, toutes ligues)
API_FOOTBALL_KEY=ta_cle_api-football
NEWS_API_KEY=ta_cle_newsapi.org

# Domaine(s) de ton site autorisé(s) en CORS. "*" = tout le monde (à éviter en prod)
CLIENT_ORIGIN=https://tonsite.com

# Fourni automatiquement par Render, inutile de le définir en local sauf besoin précis
# PORT=3000
